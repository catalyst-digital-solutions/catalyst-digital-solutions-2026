# Stripe Payment Links for the Atara private checkout page.
# Leave unset to keep the matching button disabled (same disabled styling).
NEXT_PUBLIC_ATARA_STRIPE_KICKOFF_URL=
NEXT_PUBLIC_ATARA_STRIPE_FULL_URL=

# ---------------------------------------------------------------------------
# Client onboarding (/{client}/onboarding) — all server-side only.
# Without Supabase vars, local dev uses a JSON store under start/.data
# (never on Vercel; there the page shows "temporarily unavailable").
# ---------------------------------------------------------------------------
# Supabase (Vercel Marketplace integration sets these automatically)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL, only for `npm run onboarding:migrate`
POSTGRES_URL_NON_POOLING=
# Signs the httpOnly session cookie (≥32 random chars). Falls back to a key
# derived from the Supabase service key if unset.
ONBOARDING_SESSION_SECRET=
# Email (Resend). Unset = log only. Client emails also need ONBOARDING_CLIENT_EMAILS=on.
RESEND_API_KEY=
ONBOARDING_FROM_EMAIL="Catalyst Digital Solutions <onboarding@catalyst-digital-solutions.com>"
ONBOARDING_NOTIFY_EMAIL=
ONBOARDING_CLIENT_EMAILS=off
# Optional: Bearer token for GET /api/onboarding/admin/export?instance=… (≥24 chars)
ONBOARDING_ADMIN_TOKEN=
# Optional overrides
# ONBOARDING_BASE_URL=https://start.catalyst-digital-solutions.com
# ONBOARDING_LINK_DAYS=30
# ONBOARDING_UPLOAD_BUCKET=onboarding-uploads
# Dictation uses Vercel AI Gateway (OIDC on Vercel; AI_GATEWAY_API_KEY locally).
# ONBOARDING_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
# ONBOARDING_TRANSCRIBE=off
